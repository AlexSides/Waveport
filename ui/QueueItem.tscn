[sub_resource type="GDScript" id="GDScript_vuq2w"]
script/source = "extends Control

func set_text(text: String) -> void:
	# if the node is named \"Label\" directly under the root Control:
	$Label.text = text

	# —or— if it’s nested, e.g. under an HBoxContainer:
	# $HBoxContainer/Label.text = text
"

